# NEXUS Finance - Frontend Environment Variables
# Para conectar tu proyecto de Supabase, reemplaza con tus credenciales:
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Backend FastAPI URL (opcional si usas el backend en Python)
VITE_API_URL=http://localhost:8000/api/v1
