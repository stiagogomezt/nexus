# ==============================================================================
# NEXUS FINANCE — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in the values for your specific environment.
# 3. NEVER commit .env.local or expose backend secrets with NEXT_PUBLIC_ prefixes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Client & Edge)
# ------------------------------------------------------------------------------
# Public URL of your Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key for client-side queries protected by Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server Secret (Backend / Admin Only - NEVER NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Service role key used strictly on server routes for system-level migrations/tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. AI Copilot — Google Gemini API
# ------------------------------------------------------------------------------
# Server-only Gemini API key for /api/ai/chat and server-side copilot inference
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 4. Crypto Intelligence — CoinMarketCap API & Web3 RPC
# ------------------------------------------------------------------------------
# CoinMarketCap API Key (Basic / Free tier plan from pro.coinmarketcap.com)
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key-here

# Public JSON-RPC endpoint for read-only EVM balance queries (optional, defaults to public nodes)
RPC_URL=https://eth.llamarpc.com

# ------------------------------------------------------------------------------
# 5. Open Finance / Banking Intelligence (Optional sandbox)
# ------------------------------------------------------------------------------
# Credentials for Open Finance sandbox testing (read-only consent metadata)
OPEN_FINANCE_API_KEY=your-open-finance-api-key
OPEN_FINANCE_API_SECRET=your-open-finance-api-secret
OPEN_FINANCE_ENV=sandbox
OPEN_FINANCE_BASE_URL=https://api.openfinance.co/v1
